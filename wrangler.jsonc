{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sysone-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [{ "pattern": "sysone.top", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "SYSONE_DB",
      "database_name": "sysone-production",
      "database_id": "0b6ef9ed-dc38-4c44-94b3-e947147ce8bf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SYSONE_ASSETS",
      "bucket_name": "sysone-assets"
    },
    {
      "binding": "SYSONE_DOWNLOADS",
      "bucket_name": "sysone-downloads"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SYSONE_CONFIG",
      "id": "91bd218190654724b4b3f61d032e7246"
    }
  ],
  "ratelimits": [
    {
      "name": "SYSONE_ACTIVATION_IP_RATE_LIMIT",
      "namespace_id": "26082601",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SYSONE_ACTIVATION_LICENSE_RATE_LIMIT",
      "namespace_id": "26082602",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "SYSONE_PROJECT_REQUEST_RATE_LIMIT",
      "namespace_id": "26082801",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}