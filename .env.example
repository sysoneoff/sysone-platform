# Public site URL used for canonical URLs, sitemap and social metadata.
# Local: http://localhost:3000
# Production: https://<worker-name>.<your-workers-subdomain>.workers.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=uz

# Authentication (not enabled in this public foundation deploy)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
OWNER_EMAILS=
OWNER_TELEGRAM_IDS=

# Keep the private Control Center disabled in production until real auth is wired.
ENABLE_CONTROL_CENTER_PREVIEW=false

# Optional future AI provider configuration
AI_PROVIDER=
AI_API_KEY=
